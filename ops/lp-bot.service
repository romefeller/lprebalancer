# Rebalancer — Solana concentrated-liquidity rebalancer.
#
# Copy to /etc/systemd/system/, edit User and the three paths, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now lp-bot
#
# Every trading parameter comes from the rebalancer.config table, not from here.
# Change one with:  python3 db.py set <profile> capital_usd=250
#
# LPBOT_WALLET is required and has no default: point it at your keypair.
# Stop it at any time with:  touch <install dir>/HALT
[Unit]
Description=Rebalancer — Solana concentrated-liquidity rebalancer
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=CHANGEME
WorkingDirectory=/opt/rebalancer
Environment=LPBOT_WALLET=/path/to/your/solana-keypair.json
Environment=LPBOT_RPC=https://api.mainnet-beta.solana.com
Environment=LPBOT_DSN=dbname=rebalancer
# Raydium open without Metaplex metadata, Token-2022 NFT (saves ~0.0148 SOL a cycle)
Environment=LPBOT_RAYDIUM_LEAN=1
# The payout destination, pinned outside the database: payouts go only to this address,
# whatever rebalancer.config.profit_wallet says. Set it to the profit wallet.
Environment=LPBOT_PROFIT_WALLET_PIN=CHANGEME
# Environment=LPBOT_PROFILE=sol-usdc
ExecStart=/usr/bin/python3 -u /opt/rebalancer/rebalancer.py
Restart=on-failure
RestartSec=60
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
