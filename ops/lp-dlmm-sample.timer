[Unit]
Description=Every 10 minutes, as the bots' fee_growth sampler (venue_sample_seconds 600)

[Timer]
# on the clock: a timer counted from the unit's last run had no next run
# when the unit ran before the timer was enabled (2026-10-15)
OnCalendar=*:0/10
AccuracySec=10s

[Install]
WantedBy=timers.target
