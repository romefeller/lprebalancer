# --- anything that could carry a key -----------------------------------------
# Nothing in this repo should ever hold a secret, but these are the shapes a
# leak takes, so they are refused by name as well as by review.
*.secret
*.key
*.pem
*keypair*.json
id_*.json
.env
.env.*
*.env

# --- runtime state, not source -----------------------------------------------
# These are this deployment's private operating record: wallet activity,
# position mints, transaction signatures, timings. On-chain data is public, but
# publishing it here links a repository to a wallet.
ledger.sqlite
ledger.sqlite-*
events.jsonl
telegram_bridge_state.json
runtime.json
state*.json
HALT
REBALANCE
REOPT
MIGRATE
RESCAN

# --- local junk ---------------------------------------------------------------
__pycache__/
*.pyc
node_modules/
*.log
.DS_Store

# --- migrated away, kept locally --------------------------------------------
.archive/
tape5_*.json
